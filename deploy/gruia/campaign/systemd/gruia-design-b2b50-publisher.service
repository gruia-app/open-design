[Unit]
Description=Publish reviewed Gruia B2B examples to Vercel
After=network-online.target
StartLimitIntervalSec=0
[Service]
Type=oneshot
Environment=GRUIA_B2B50_STATE=/home/roberto/.local/state/gruia-design-b2b50
Environment=GRUIA_VERCEL_BIN=/home/roberto/.local/bin/vercel
Environment=GRUIA_PUBLIC_VERIFY_HOST=demo-apps-root
ExecStart=/home/roberto/.local/bin/node --experimental-strip-types /home/roberto/.local/state/gruia-design-b2b50/publisher.ts
UMask=0077
NoNewPrivileges=true
StandardOutput=append:/home/roberto/.local/state/gruia-design-b2b50/publisher.log
StandardError=append:/home/roberto/.local/state/gruia-design-b2b50/publisher.log
