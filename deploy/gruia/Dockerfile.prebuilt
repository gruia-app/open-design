# syntax=docker/dockerfile:1.7
# Fast local-only image: see docs/gruia-deployment.md for preparing .prebuilt.
ARG NODE_IMAGE=node:24-bookworm-slim
FROM ${NODE_IMAGE}

ARG CLAUDE_CODE_VERSION=2.1.261
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash ca-certificates chromium dumb-init fonts-noto-core fonts-noto-color-emoji git poppler-utils \
    && npm install --global --omit=dev "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && groupadd --gid 1001 open-design \
    && useradd --uid 1001 --gid 1001 --create-home --home-dir /var/lib/open-design/home --shell /usr/sbin/nologin open-design \
    && rm -rf /var/lib/apt/lists/* /root/.npm

WORKDIR /app
# Named build context `prebuilt` is an intentionally local artifact directory;
# it avoids the repository .dockerignore excluding nested dist/ directories.
COPY --from=prebuilt --chown=1001:1001 daemon ./apps/daemon
COPY --chown=1001:1001 apps/web/out ./apps/web/out
COPY --chown=1001:1001 skills ./skills
COPY --chown=1001:1001 design-templates ./design-templates
COPY --chown=1001:1001 design-systems ./design-systems
COPY --chown=1001:1001 craft ./craft
COPY --chown=1001:1001 prompt-templates ./prompt-templates
COPY --chown=1001:1001 assets ./assets
COPY --chown=1001:1001 data ./data
COPY --chown=1001:1001 plugins/_official ./plugins/_official
COPY --chown=1001:1001 plugins/registry ./plugins/registry
COPY --chown=1001:1001 deploy/gruia/open-design-entrypoint.sh /usr/local/bin/open-design-entrypoint
RUN chmod 0755 /usr/local/bin/open-design-entrypoint && mkdir -p /var/lib/open-design/claude && chown -R 1001:1001 /app /var/lib/open-design

ENV NODE_ENV=production NODE_OPTIONS=--max-old-space-size=384 OD_BIND_HOST=0.0.0.0 OD_PORT=7456 OD_RESOURCE_ROOT=/app OD_DATA_DIR=/var/lib/open-design HOME=/var/lib/open-design/home CLAUDE_CONFIG_DIR=/var/lib/open-design/claude PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
EXPOSE 7456
USER 1001:1001
ENTRYPOINT ["dumb-init", "--", "/usr/local/bin/open-design-entrypoint"]
CMD ["node", "apps/daemon/dist/cli.js", "--no-open"]
